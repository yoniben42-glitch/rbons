# ---------------------------------------------------------------------------
# Rbonsu Photography — environment template. Names only, never real values.
#
# Local development:  copy to .env (Vite) and/or .dev.vars (wrangler dev).
# Production:         set these on the Worker.
#                       wrangler secret put <NAME>     for SERVER-ONLY SECRETS
#                       [vars] in wrangler.jsonc       for non-secret values
# Both .env and .dev.vars are gitignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# ===========================================================================
# PUBLIC VARIABLES — compiled into the browser bundle. Safe to expose.
# Anything prefixed VITE_ IS SHIPPED TO THE BROWSER. Never put a secret here.
# ===========================================================================

# Route gallery images through Supabase image transformations ("true"/"false").
VITE_SUPABASE_IMAGE_TRANSFORM=false


# ===========================================================================
# SERVER-ONLY CONFIGURATION — non-secret, but never read by browser code.
# ===========================================================================

# Canonical public origin. Used for origin checks and Stripe return URLs.
# Local: http://localhost:8080   Production: https://www.rbonsuphotography.com
APP_ORIGIN=http://localhost:8080

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=https://qpavbelrhifpkxncwbnr.supabase.co

# Public Storage bucket holding gallery originals.
SUPABASE_STORAGE_BUCKET=rbonsu-photography

# Sender and studio notification addresses for Resend.
RESEND_FROM_EMAIL=RBONSU Photography <noreply@rbonsuphotography.com>
STUDIO_NOTIFICATION_EMAIL=info@rbonsuphotography.com

# ===========================================================================
# SERVER-ONLY SECRETS — set with `wrangler secret put <NAME>`.
# These must NEVER appear in frontend code, in a VITE_ variable, or in git.
# ===========================================================================

# Supabase service-role key. Bypasses row-level security; server use only.
SUPABASE_SERVICE_ROLE_KEY=

# Shared admin dashboard credential. Treat as a password; rotate on handover.
# Rotating this value also immediately invalidates every existing admin
# session (see docs/SECURITY.md), so it doubles as a "sign everyone out" switch.
ADMIN_DASHBOARD_TOKEN=

# Optional but strongly recommended: enables TOTP MFA on top of
# ADMIN_DASHBOARD_TOKEN for admin login. Base32 secret, e.g. generated with
# `node scripts/generate-admin-secret.mjs --totp` and enrolled in an
# authenticator app (Google Authenticator, 1Password, etc). Leave unset to
# skip MFA (not recommended for a production deployment).
ADMIN_TOTP_SECRET=

# Salt used to hash identifiers before they are written to audit records.
AUDIT_HASH_SALT=

# Stripe hosted Checkout. Required only when Stripe is enabled in Admin > Payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email (optional; email is skipped when unset).
RESEND_API_KEY=
