{
  "name": "rbonsu-photography",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "vite build && tsc --noEmit",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "playwright test",
    "test:security": "playwright test tests/security.spec.ts",
    "security:check": "npm run security:scan && npm audit --audit-level=high",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm --output-file sbom.json",
    "security:scan": "node scripts/security-scan.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "dev:cloudflare": "npm run build && wrangler dev",
    "verify:inquiry-storage": "node scripts/verify-inquiry-storage.mjs",
    "inquiries:list": "node scripts/list-inquiries.mjs",
    "verify:cloudflare": "node scripts/verify-cloudflare-deployment.mjs",
    "integration:check": "node scripts/integration-check.mjs",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "lucide-react": "^0.510.0",
    "motion": "^13.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lightningcss": "^1.28.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0",
    "wrangler": "^4.135.0"
  },
  "version": "1.5.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  }
}
